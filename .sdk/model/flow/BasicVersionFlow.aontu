# BasicVersionFlow

main: kit: flow: BasicVersionFlow:
{
  entity: "version",
  kind: "basic",
  name: "BasicVersionFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "version_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "version_ref01",
        srcdatavar: "version_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "version01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-version_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicVersionFlow"
}