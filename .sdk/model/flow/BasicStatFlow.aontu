# BasicStatFlow

main: kit: flow: BasicStatFlow:
{
  entity: "stat",
  kind: "basic",
  name: "BasicStatFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "stat_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "stat_ref01",
        srcdatavar: "stat_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "stat01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-stat_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicStatFlow"
}